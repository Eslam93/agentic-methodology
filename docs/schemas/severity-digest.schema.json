{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Severity digest",
  "description": "Machine-readable merge-gate contract. Enforces: merge_allowed <=> action_required empty; PASS has no action_required; FAIL has >=1; reproducible_recipe evidence needs expected+actual. Unknown top-level fields rejected (use extensions).",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "findings", "direction_delta", "merge_allowed"],
  "properties": {
    "verdict": { "enum": ["PASS", "CONCERNS", "FAIL", "WAIVED"] },
    "merge_allowed": { "type": "boolean" },
    "direction_delta": { "type": "string" },
    "extensions": { "type": "object" },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reason", "owner", "replacement_evidence", "expiry", "followup"],
        "properties": {
          "reason": { "type": "string" },
          "owner": { "type": "string" },
          "replacement_evidence": { "type": "string" },
          "expiry": { "type": "string" },
          "followup": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_required", "recommended", "minor"],
      "properties": {
        "action_required": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "evidence"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "file": { "type": "string" },
              "evidence": {
                "type": "object",
                "required": ["type", "detail"],
                "properties": {
                  "type": { "enum": ["failing_check", "concrete_reproducer", "reviewer_recompute", "spec_line", "reproducible_recipe"] },
                  "detail": { "type": "string", "minLength": 1 },
                  "expected": { "type": "string" },
                  "actual": { "type": "string" }
                },
                "allOf": [
                  {
                    "if": { "required": ["type"], "properties": { "type": { "const": "reproducible_recipe" } } },
                    "then": { "required": ["expected", "actual"] }
                  }
                ]
              }
            }
          }
        },
        "recommended": { "type": "array", "items": { "type": "object" } },
        "minor": { "type": "array", "items": { "type": "object" } }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["findings"], "properties": { "findings": { "required": ["action_required"], "properties": { "action_required": { "minItems": 1 } } } } },
      "then": { "properties": { "merge_allowed": { "const": false } } },
      "else": { "properties": { "merge_allowed": { "const": true } } }
    },
    {
      "if": { "required": ["verdict"], "properties": { "verdict": { "const": "PASS" } } },
      "then": { "properties": { "findings": { "properties": { "action_required": { "maxItems": 0 } } } } }
    },
    {
      "if": { "required": ["verdict"], "properties": { "verdict": { "const": "FAIL" } } },
      "then": { "properties": { "findings": { "properties": { "action_required": { "minItems": 1 } } } } }
    }
  ]
}
